# ==============================================================================
# Alexandrie — Coolify "uzaksunucu" ortam şablonu
# Bu dosyayı .env.coolify olarak kopyalayın ancak GERÇEK DEĞERLERİ
# Coolify UI > Environment Variables bölümüne girin.
# ==============================================================================

# -----------------------------------------------------------------------------
# 1. DOMAIN / PUBLIC URLS
# -----------------------------------------------------------------------------
FRONTEND_DOMAIN=alexandrie.testedeli.online
API_DOMAIN=api.alexandrie.testedeli.online
CDN_DOMAIN=cdn.alexandrie.testedeli.online

FRONTEND_URL=https://alexandrie.testedeli.online
API_URL=https://api.alexandrie.testedeli.online
CDN_URL=https://cdn.alexandrie.testedeli.online

# S3 bucket path prefix; bucket adı "alexandrie" ise bu /alexandrie/ kalmalı
CDN_ENDPOINT=/alexandrie/

# Ortak üst domain; frontend ve API subdomain'lerini paylaşır
COOKIE_DOMAIN=testedeli.online

# HTTPS ortamında false
ALLOW_UNSECURE=false

# -----------------------------------------------------------------------------
# 2. SECURITY
# -----------------------------------------------------------------------------
# Güçlü, rastgele JWT secret (örn. openssl rand -hex 32)
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_SECRET

# -----------------------------------------------------------------------------
# 3. FEATURE FLAGS
# -----------------------------------------------------------------------------
# Ekip kendi kaydolacaksa false; sadece davetiye ile üyelik için true
CONFIG_DISABLE_SIGNUP=false

CONFIG_DISABLE_LANDING=false
CONFIG_DISABLE_NATIVE_LOGIN=false
CONFIG_HIDE_NATIVE_LOGIN_FORM=false

# OIDC otomatik yönlendirme (isteğe bağlı)
# CONFIG_OIDC_PROVIDER_AUTO_REDIRECT=

# -----------------------------------------------------------------------------
# 4. MYSQL
# -----------------------------------------------------------------------------
MYSQL_DATABASE=alexandrie
MYSQL_USER=alexandrie
MYSQL_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_THIS_TO_A_STRONG_ROOT_PASSWORD

# -----------------------------------------------------------------------------
# 5. RUSTFS / S3
# -----------------------------------------------------------------------------
RUSTFS_ACCESS_KEY=CHANGE_THIS_TO_A_STRONG_ACCESS_KEY
RUSTFS_SECRET_KEY=CHANGE_THIS_TO_A_STRONG_SECRET_KEY
MINIO_BUCKET=alexandrie

RUSTFS_CONSOLE_ENABLE=false
RUSTFS_LOG_LEVEL=info

# -----------------------------------------------------------------------------
# 6. SMTP (opsiyonel — sadece şifre sıfırlama için)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_MAIL=
SMTP_MAIL_FROM=
SMTP_PASSWORD=

# -----------------------------------------------------------------------------
# 7. OIDC (opsiyonel — 1..10 arası tanımlanabilir)
# -----------------------------------------------------------------------------
# OIDC_1_PROVIDER_NAME=authentik
# OIDC_1_CONFIG_URL=https://sso.example.com/application/o/alexandrie/.well-known/openid-configuration
# OIDC_1_CLIENT_ID=...
# OIDC_1_CLIENT_SECRET=...
